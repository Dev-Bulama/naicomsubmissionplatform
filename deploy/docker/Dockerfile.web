# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY NLIP.sln .
COPY src/NLIP.Shared/NLIP.Shared.csproj src/NLIP.Shared/
COPY src/NLIP.Web/NLIP.Web.csproj src/NLIP.Web/
RUN dotnet restore src/NLIP.Web/NLIP.Web.csproj

COPY . .
RUN dotnet publish src/NLIP.Web/NLIP.Web.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
RUN useradd --uid 5001 nlip
USER nlip
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8081
EXPOSE 8081
ENTRYPOINT ["dotnet", "NLIP.Web.dll"]
