{
  "_comment": "No secrets are checked in here — every value below that matters (SigningKey, Encryption:Key, ConnectionStrings, Naicom:Sid/Secret) is blank on purpose and MUST be supplied via environment variables (see .env.example / docker-compose.yml) or a secret store (Key Vault). A blank SigningKey/Encryption:Key fails fast with a clear error at the point of use rather than silently running insecurely.",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Issuer": "NLIP",
    "Audience": "NLIP.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 30
  },
  "Encryption": {
    "Key": ""
  },
  "Naicom": {
    "BaseUrl": "https://portal.naicom.gov.ng/",
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerBreakSeconds": 30,
    "BulkheadMaxParallelization": 10,
    "BulkheadMaxQueuedActions": 20
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7443" ]
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "POST:/api/auth/login", "Period": "1m", "Limit": 10 },
      { "Endpoint": "*", "Period": "1s", "Limit": 20 },
      { "Endpoint": "*", "Period": "1m", "Limit": 300 }
    ]
  },
  "Logging": {
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*"
}
