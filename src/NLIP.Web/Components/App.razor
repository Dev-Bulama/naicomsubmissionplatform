@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NLIP — NAICOM Life Assurance Integration Platform</title>
    <base href="/" />
    <!--
        Bootstrap/Chart.js are loaded from a CDN with no Subresource Integrity hash pinned here —
        this dev environment could not reach the CDN to compute a verified hash (see
        docs/DEPLOYMENT.md). Before production, either vendor both libraries under wwwroot/lib
        and reference them locally, or pin the exact integrity="sha384-..." hash published by the
        CDN for the pinned version.
    -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="css/app.css" />
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="js/site.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
