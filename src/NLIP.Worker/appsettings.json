{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=NlipDb;User Id=sa;Password=#{DB_PASSWORD}#;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Redis": "redis:6379"
  },
  "Naicom": {
